name: Build Moul Al Hanout

on:
  workflow_dispatch:
  push:
    branches: [ "main", "master" ]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Locate project
        shell: bash
        run: |
          set -e
          if [ -f "Moul_Al_Hanout.zip" ]; then
            rm -rf build-project
            mkdir build-project
            unzip -q "Moul_Al_Hanout.zip" -d build-project
          elif [ -f "settings.gradle" ]; then
            mkdir -p build-project
            shopt -s dotglob
            cp -R ./* build-project/
          else
            echo "Moul_Al_Hanout.zip or settings.gradle was not found."
            exit 1
          fi

      - name: Build debug APK and release AAB
        working-directory: build-project
        run: |
          gradle --no-daemon assembleDebug bundleRelease

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: moul-al-hanout-debug-apk
          path: build-project/app/build/outputs/apk/debug/app-debug.apk

      - name: Upload AAB
        uses: actions/upload-artifact@v4
        with:
          name: moul-al-hanout-release-aab-unsigned
          path: build-project/app/build/outputs/bundle/release/app-release.aab
